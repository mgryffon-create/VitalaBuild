# ========================
# VitalaMatch .gitignore
# ========================

# ----- Environment & Secrets -----
.env
.env.*
!.env.example
frontend/.env
backend/.env

# ----- Dependencies -----
node_modules/
__pycache__/
*.pyc
venv/
.venv/

# ----- Build Outputs -----
frontend/build/
dist/
*.tsbuildinfo

# ----- Uploaded User Files -----
backend/uploads/

# ----- Database Backups -----
backups/

# ----- Test Artifacts -----
test_reports/
test_result.md
backend_test.py
backend_test_results.json
coverage/
.pytest_cache/
htmlcov/

# ----- Memory / Credentials -----
memory/test_credentials.md

# ----- IDE & System -----
.idea/
.vscode/
.DS_Store
*.pem
*.swp
*~

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Platform -----
.emergent/
.vercel/
.cache/

# ----- Archive & Binary -----
*.zip
*.tar.gz
*.tar
*.tgz
*.pack
*.deb
*.bson
frontend/node_modules/.cache/default-development/0.pack
*.env
credentials.json
*.key
.credentials
