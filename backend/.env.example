# Supabase transaction pooler URL (Connect > Transaction pooler); backend only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# New sb_secret key (or legacy service_role for compatibility). Never expose.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=documents
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CRON_SECRET=
# Optional independent provider integrations. Missing keys disable the service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@vitalamatch.com
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
NURSYS_API_KEY=
ALLOW_DEV_BYPASS=false
