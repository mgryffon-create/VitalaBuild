# VitalaMatch Backend Environment
# Copy to .env and fill in your values

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017
DB_NAME=vitalamatch

# CORS allowed origins (comma-separated, or * for dev)
CORS_ORIGINS=http://localhost:3000

# JWT secret (generate a strong random string for production)
JWT_SECRET=change-me-to-a-secure-random-string

# Frontend URL (used for email links, redirects)
FRONTEND_URL=http://localhost:3000

# Twilio SMS (optional — leave blank to disable)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=

# Emergent LLM Key (for document verification via GPT Vision)
EMERGENT_LLM_KEY=

# Stripe (for payment features)
STRIPE_API_KEY=

# Dev bypass flag (set to false in production)
ALLOW_DEV_BYPASS=false
